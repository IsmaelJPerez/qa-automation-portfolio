      "name": "01-Headers",
      "item": [
        {
          "name": "01 - GET headers HTTPBin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"X-Demo-Trace reflejado en la response\", () => {\r\n    const headers = pm.response.json().headers;\r\n    pm.expect(headers[\"X-Demo-Trace\"]).to.eql(\"lab-ismael-001\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Demo-Trace",
                "value": "lab-ismael-001"
              }
            ],
            "url": {
              "raw": "https://httpbin.org/headers",
              "protocol": "https",
              "host": [
                "httpbin",
                "org"
              ],
              "path": [
                "headers"
              ]
            }
          },
          "response": []
        }
      ]
    },
