                  "pm.test(\"Login devuelve 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"La respuesta trae accessToken\", () => {\r\n    pm.expect(pm.response.json().accessToken).to.be.a(\"string\");\r\n});\r\n\r\npm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
                ]
