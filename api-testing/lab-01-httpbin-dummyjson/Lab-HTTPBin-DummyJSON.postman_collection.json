    {
      "name": "03-Variables",
      "item": [
        {
          "name": "05 - GET posts con baseUrl",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Devuelve una lista de posts no vacía\", () => {\r\n    const body = pm.response.json();\r\n    pm.expect(body.posts).to.be.an(\"array\").that.is.not.empty;\r\n});\r\n\r\npm.test(\"La request usó la variable baseUrl del environment\", () => {\r\n    pm.expect(pm.request.url.toString()).to.include(\"dummyjson.com\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04-Datos-dinamicos",
      "item": [
        {
          "name": "06 - POST datos dinamicos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Los datos dinámicos llegaron al servidor con el formato correcto\", () => {\r\n    const enviado = pm.response.json().json;\r\n    pm.expect(enviado.nombre).to.be.a(\"string\").and.not.empty;\r\n    pm.expect(enviado.email).to.include(\"@\");\r\n    pm.expect(enviado.edad).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"Cada {{$randomEmail}} genera un valor distinto\", () => {\r\n    const enviado = pm.response.json().json;\r\n    pm.expect(enviado.email).to.not.eql(enviado.emailConfirmacion);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nombre\": \"{{$randomFullName}}\",\r\n  \"email\": \"{{$randomEmail}}\",\r\n  \"emailConfirmacion\": \"{{$randomEmail}}\",\r\n  \"edad\": {{$randomInt}},\r\n  \"idExterno\": \"{{$guid}}\",\r\n  \"creadoEn\": {{$timestamp}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://httpbin.org/post",
              "protocol": "https",
              "host": [
                "httpbin",
                "org"
              ],
              "path": [
                "post"
              ]
            }
          },
          "response": []
        },
        {
          "name": "07 - POST dato dinamico reutilizable",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.variables.replaceIn(\"{{$randomEmail}}\");\r\npm.variables.set(\"emailPrueba\", email);\r\nconsole.log(\"Email generado:\", email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Los dos emails coinciden\", () => {\r\n    const enviado = pm.response.json().json;\r\n    pm.expect(enviado.email).to.eql(enviado.emailConfirmacion);\r\n});\r\n\r\npm.test(\"La API recibio el email que generamos\", () => {\r\n    pm.expect(pm.response.json().json.email).to.eql(pm.variables.get(\"emailPrueba\"));\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nombre\": \"{{$randomFullName}}\",\r\n  \"email\": \"{{emailPrueba}}\",\r\n  \"emailConfirmacion\": \"{{emailPrueba}}\",\r\n  \"edad\": {{$randomInt}},\r\n  \"idExterno\": \"{{$guid}}\",\r\n  \"creadoEn\": {{$timestamp}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
